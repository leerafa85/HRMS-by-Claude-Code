# Copiar a .env (o cargar en el panel del hosting) y completar.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=rrhh.miempresa.com.ar
DJANGO_CSRF_TRUSTED_ORIGINS=https://rrhh.miempresa.com.ar
# PostgreSQL recomendado en producción. Sin esta variable se usa SQLite (solo para pruebas).
DATABASE_URL=postgres://usuario:clave@host:5432/hrms
# Carpeta persistente para documentos, fotos y CVs (debe ser un disco persistente).
DJANGO_MEDIA_ROOT=/var/data/media
HRMS_MAX_UPLOAD_MB=10
# Usuario administrador inicial (lo crea "python manage.py inicializar")
HRMS_ADMIN_USER=admin
HRMS_ADMIN_PASSWORD=cambiar-esta-clave
HRMS_ADMIN_EMAIL=rrhh@miempresa.com.ar
# Email (opcional, para avisos de licencias)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=rrhh@miempresa.com.ar
