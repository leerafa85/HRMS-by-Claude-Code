{
  "name": "HRMS (prueba en Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "HRMS_ADMIN_USER": "admin",
    "HRMS_ADMIN_PASSWORD": "admin1234"
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "postAttachCommand": "bash .devcontainer/iniciar.sh",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "HRMS",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
